    "@mui/x-charts": "^9.7.0",
    "@mui/x-data-grid": "^9.7.0",
    "@mui/x-date-pickers": "^9.7.0",
    "@mui/x-tree-view": "^9.7.0",
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
